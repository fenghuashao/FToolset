{
  "name": "ftoolset",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "An offline Chrome toolset with QR code generator & decoder, link cleaner, text cleaner, and screen color picker.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wxt -b chrome",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wxt build -b chrome --mv3",
    "test:e2e": "playwright test",
    "icons:generate": "node scripts/generate-icons.mjs",
    "zip": "wxt zip -b chrome --mv3"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "qr-code-styling": "1.9.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
